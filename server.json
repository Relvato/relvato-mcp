{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.relvato/relvato",
  "title": "Relvato",
  "description": "Website monitoring: add sites, configure and run monitors, read health, review results, apply fixes.",
  "version": "3.2.0",
  "websiteUrl": "https://www.relvato.com/developers",
  "repository": {
    "url": "https://github.com/Relvato/relvato-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://www.relvato.com/logo-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.relvato.com/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. Your Relvato API key as a Bearer token, from API access (app.relvato.com/api-access). Leave it out to sign in with OAuth instead.",
          "isRequired": false,
          "isSecret": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "Relvato API key (starts with rlv_)",
              "isRequired": true,
              "isSecret": true,
              "placeholder": "rlv_…"
            }
          }
        }
      ]
    }
  ]
}
